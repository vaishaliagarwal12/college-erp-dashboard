# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# SERVER_URL=http://localhost:5000

# MongoDB — never commit real credentials. Use your own URI.
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/collegeERP

# JWT — production should use a long random string, e.g.:
#   openssl rand -hex 64
# Access token (short-lived)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE=15m

# Refresh token (long-lived, rotating). Separate secret recommended.
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-secret
REFRESH_TOKEN_EXPIRE=7d

# Rate limiting (optional overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5

# Seed admin (npm run seed:admin)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=ChangeMe123!

# Google SSO (optional — enables "Continue with Google")
# Credentials from: https://console.cloud.google.com/apis/credentials
# Add http://localhost:5000/api/v1/auth/google/callback as an authorized redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Account security (optional overrides)
# Lock an account after this many consecutive failed logins
LOCKOUT_MAX_ATTEMPTS=5
# How long the account stays locked after reaching the limit (ms)
LOCKOUT_WINDOW_MS=900000
# Number of previous password hashes kept to block reuse
PASSWORD_HISTORY_LENGTH=5
# Force password change after this many days (0 disables expiry)
PASSWORD_MAX_AGE_DAYS=0
# Set true to block login until the email address is verified
REQUIRE_EMAIL_VERIFICATION=false

# Faculty workload (optional overrides)
# Max teaching hours a faculty member can carry per week across a term
WORKLOAD_MAX_WEEKLY_HOURS=20

# Redis (optional) — enables the BullMQ job queue and response caching.
# Leave unset to run jobs in-process with graceful fallback.
# REDIS_URL=redis://localhost:6379

# Multi-tenancy (optional) — set to a Tenant _id to force tenant isolation on
# core reference data (departments, courses). Clients may also send the
# X-Tenant-ID header per request.
# DEFAULT_TENANT_ID=
